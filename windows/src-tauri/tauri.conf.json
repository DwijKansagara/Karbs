{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Karbs",
  "version": "0.2.0",
  "identifier": "com.dwijkansagara.karbs",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420"
    },
    "windows": [
      {
        "label": "island",
        "title": "Karbs",
        "url": "index.html",
        "width": 240,
        "height": 6,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": true,
        "center": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "dragDropEnabled": true,
        "additionalBrowserArgs": "--autoplay-policy=no-user-gesture-required"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../target/release/karbs-hook.exe": "karbs-hook.exe",
      "../../runtime/": "runtime/"
    },
    "copyright": "Original source © 2026 Louis Raillé; Karbs changes © 2026 Dwij Kansagara",
    "category": "DeveloperTool",
    "shortDescription": "Codex and Gemini in a desktop activity panel",
    "longDescription": "Karbs connects Codex and Gemini chat to a Windows activity panel, optional desktop tools, attachments and voice.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English"
        ],
        "installerHooks": "nsis/hooks.nsh"
      }
    },
    "createUpdaterArtifacts": true,
    "useLocalToolsDir": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDAxMEFDMTMxRDIyMTJCQ0UKUldUT0t5SFNNY0VLQVdFbW4zVkFxV0ZWa2F3VHMvbGRLd3lPaWV6VDIwcFc0WkN2TmVNQm42aTgK",
      "endpoints": [
        "https://github.com/DwijKansagara/Karbs/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "mainBinaryName": "karbs"
}
